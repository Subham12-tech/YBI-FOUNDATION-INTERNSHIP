      "source": [
        "# Python Lists\n",
        "\n",
        "A list is a collection of ordered, changeable and indexed elements in Python."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 1. Creating a List\n",
        "fruits = [\"Apple\", \"Banana\", \"Mango\", \"Orange\"]\n",
        "print(fruits)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 2. List with Different Data Types\n",
        "my_list = [10, \"Python\", 3.14, True]\n",
        "print(my_list)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 3. Accessing List Elements\n",
        "fruits = [\"Apple\", \"Banana\", \"Mango\", \"Orange\"]\n",
        "print(fruits[0])\n",
        "print(fruits[2])"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 4. Negative Indexing\n",
        "fruits = [\"Apple\", \"Banana\", \"Mango\", \"Orange\"]\n",
        "print(fruits[-1])\n",
        "print(fruits[-2])"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 5. List Slicing\n",
        "numbers = [10, 20, 30, 40, 50]\n",
        "print(numbers[1:4])\n",
        "print(numbers[:3])\n",
        "print(numbers[2:])"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 6. Changing List Elements\n",
        "fruits = [\"Apple\", \"Banana\", \"Mango\"]\n",
        "fruits[1] = \"Grapes\"\n",
        "print(fruits)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 7. append() - Add an Element at the End\n",
        "fruits = [\"Apple\", \"Banana\"]\n",
        "fruits.append(\"Mango\")\n",
        "print(fruits)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 8. insert() - Add Element at a Specific Position\n",
        "fruits = [\"Apple\", \"Mango\"]\n",
        "fruits.insert(1, \"Banana\")\n",
        "print(fruits)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 9. extend() - Add Multiple Elements\n",
        "fruits = [\"Apple\", \"Banana\"]\n",
        "more_fruits = [\"Mango\", \"Orange\"]\n",
        "fruits.extend(more_fruits)\n",
        "print(fruits)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 10. remove() - Remove a Specific Element\n",
        "fruits = [\"Apple\", \"Banana\", \"Mango\"]\n",
        "fruits.remove(\"Banana\")\n",
        "print(fruits)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 11. pop() - Remove an Element by Index\n",
        "fruits = [\"Apple\", \"Banana\", \"Mango\"]\n",
        "removed = fruits.pop(1)\n",
        "print(\"Removed:\", removed)\n",
        "print(fruits)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 12. del - Delete an Element\n",
        "numbers = [10, 20, 30, 40]\n",
        "del numbers[1]\n",
        "print(numbers)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 13. clear() - Remove All Elements\n",
        "numbers = [10, 20, 30, 40]\n",
        "numbers.clear()\n",
        "print(numbers)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 14. len() - Find Length of a List\n",
        "fruits = [\"Apple\", \"Banana\", \"Mango\", \"Orange\"]\n",
        "print(\"Length:\", len(fruits))"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 15. count() - Count Occurrences\n",
        "numbers = [10, 20, 10, 30, 10, 40]\n",
        "print(numbers.count(10))"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 16. index() - Find Position of an Element\n",
        "fruits = [\"Apple\", \"Banana\", \"Mango\", \"Orange\"]\n",
        "print(fruits.index(\"Mango\"))"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 17. sort() - Sort a List\n",
        "numbers = [50, 10, 40, 20, 30]\n",
        "numbers.sort()\n",
        "print(numbers)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 18. reverse() - Reverse a List\n",
        "numbers = [10, 20, 30, 40, 50]\n",
        "numbers.reverse()\n",
        "print(numbers)"
      ]
    },
    {
      "cell_type": "code",
